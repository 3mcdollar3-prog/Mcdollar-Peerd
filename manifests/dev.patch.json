{
  "name": "mcdollar (dev)",
  "browser_specific_settings": {
    "gecko": {
      "id": "mcdollar-dev@mcdollar.ai",
      "strict_min_version": "154.0"
    }
  },
  "action": {
    "default_title": "mcdollar (dev)"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' blob: https: wss: http://*:11434"
  },
  "web_accessible_resources": [
    {
      "resources": ["tests/runner.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
